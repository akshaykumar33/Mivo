{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./apps/web/src/*"],
      "@mivo/shared": ["./packages/shared/src/index.ts"],
      "@mivo/database": ["./packages/database/src/index.ts"],
      "@mivo/ui": ["./packages/ui/src/index.ts"]
    }
  },
  "include": [
    "tests/**/*",
    "apps/**/*",
    "packages/**/*",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "dist", ".next"]
}
